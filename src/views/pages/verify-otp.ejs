<%- include('../partials/header', { title: 'Verify Email - Share&Go' }) %>

<div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Verify your email</h1>
                <p class="text-muted small mb-4">
                    We sent a 6-digit code to <strong><%= email %></strong>.
                    It expires in 5 minutes.
                </p>

                <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                    <div class="alert alert-danger"><%= errorMessage %></div>
                <% } %>
                <% if (typeof infoMessage !== 'undefined' && infoMessage) { %>
                    <div class="alert alert-success"><%= infoMessage %></div>
                <% } %>

                <form action="/user/verify-email" method="POST" novalidate>
                    <input type="hidden" name="email" value="<%= email %>">

                    <div class="mb-3">
                        <label for="otp" class="form-label">Verification code</label>
                        <input
                            type="text"
                            class="form-control text-center fs-4 letter-spacing <%= errors && errors.otp ? 'is-invalid' : '' %>"
                            id="otp" name="otp"
                            maxlength="6" inputmode="numeric" autocomplete="one-time-code"
                            placeholder="123456" autofocus>
                        <% if (errors && errors.otp) { %>
                            <div class="invalid-feedback"><%= errors.otp[0] %></div>
                        <% } %>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">Verify</button>
                </form>

                <form action="/user/resend-otp" method="POST" class="text-center mt-2">
                    <input type="hidden" name="email" value="<%= email %>">
                    <button type="submit" class="btn btn-link btn-sm p-0">
                        Didn't get a code? Resend
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>