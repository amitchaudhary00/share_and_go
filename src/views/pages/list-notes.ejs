<!-- views/notes/list.ejs -->
<%- include('../partials/header') %>

<div class="container mt-4" style="max-width: 720px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Notes</h2>
    <a href="/notes/create" class="btn btn-primary">+ New Note</a>
  </div>

  <% if (notes.length === 0) { %>
    <p class="text-muted">No notes yet. Create your first one.</p>
  <% } %>

  <div class="list-group">
    <% notes.forEach(note => { %>
      <a href="/notes/<%= note._id %>" class="list-group-item list-group-item-action">
        <div class="d-flex justify-content-between">
          <strong><%= note.title || 'Untitled Note' %></strong>
          <% if (note.expiresAt) { %>
            <span class="badge bg-warning text-dark">Expires <%= new Date(note.expiresAt).toLocaleDateString() %></span>
          <% } %>
        </div>
        <small class="text-muted"><%= new Date(note.createdAt).toLocaleString() %></small>
      </a>
    <% }) %>
  </div>
</div>

<%- include('../partials/footer') %>