<%- include('../partials/header') %>

<div class="note-page">

  <div class="note-header">
    <input
      id="title"
      type="text"
      name="title"
      form="note-form"
      value="<%= old?.title || '' %>"
      placeholder="Untitled"
      autocomplete="off"
      spellcheck="true"
    >
  </div>

  <% if (errors) { %>
    <div class="note-errors">
      <ul>
        <% Object.values(errors).flat().forEach(msg => { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form id="note-form" action="/notes" method="POST">

    <!-- FIXED TOOLBAR -->
    <div id="toolbar" class="editor-toolbar">

      <button type="button" data-cmd="undo" title="Undo">↶</button>
      <button type="button" data-cmd="redo" title="Redo">↷</button>

      <span class="tb-divider"></span>

      <select id="heading-select" title="Text style">
        <option value="paragraph">Paragraph</option>
        <option value="1">Heading 1</option>
        <option value="2">Heading 2</option>
        <option value="3">Heading 3</option>
      </select>

      <span class="tb-divider"></span>

      <button type="button" data-cmd="bulletList" title="Bullet list">☰</button>
      <button type="button" data-cmd="orderedList" title="Numbered list">≡</button>

      <span class="tb-divider"></span>

      <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
      <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
      <button type="button" data-cmd="strike" title="Strikethrough"><s>S</s></button>
      <button type="button" data-cmd="underline" title="Underline"><u>U</u></button>
      <button type="button" data-cmd="code" title="Inline code">&lt;/&gt;</button>

      <span class="tb-divider"></span>

      <button type="button" data-cmd="blockquote" title="Quote">❝</button>
      <button type="button" data-cmd="link" title="Add link">🔗</button>

    </div>

    <div class="editor-shell">
      <div id="editor" class="note-editor"></div>
    </div>

    <textarea id="initial-content" hidden><%= old?.content || '<p></p>' %></textarea>
    <input type="hidden" name="content" id="content-input">

    <div class="note-footer">
      <div class="expiry">
        <label for="expiryChoice">Auto-delete</label>
        <select id="expiryChoice" name="expiryChoice">
          <option value="never" selected>Never</option>
          <option value="hours_24">After 24 hours</option>
          <option value="days_3">After 3 days</option>
          <option value="days_7">After 7 days</option>
        </select>
      </div>

      <div class="note-actions">
        <a href="/notes" class="cancel-btn">Cancel</a>
        <button type="submit" class="save-btn">Save note</button>
      </div>
    </div>

  </form>

</div>

<style>

.note-page {
  max-width: 850px;
  margin: 0 auto;
  padding: 40px 32px 100px;
  color: #202124;
}

.note-header {
  margin-bottom: 18px;
}

.note-header input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  font-size: 38px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1px;
  color: #202124;
}

.note-header input::placeholder {
  color: #b7b7b7;
}

.note-errors {
  margin-bottom: 20px;
  padding: 12px 16px;
  border-radius: 10px;
  background: #fff1f1;
  color: #b42318;
}

.note-errors ul {
  margin: 0;
  padding-left: 20px;
}

/* ================= FIXED TOOLBAR ================= */

.editor-toolbar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  padding: 8px 10px;
  border: 1px solid #e2e2e2;
  border-radius: 10px 10px 0 0;
  background: #fafafa;
}

.editor-toolbar button {
  min-width: 32px;
  height: 32px;
  padding: 0 6px;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: #333;
  cursor: pointer;
  font-size: 14px;
}

.editor-toolbar button:hover {
  background: #ececec;
}

.editor-toolbar button.active {
  background: #e0e0e0;
}

.editor-toolbar select {
  height: 32px;
  padding: 0 6px;
  border: 1px solid #e2e2e2;
  border-radius: 6px;
  background: white;
  color: #333;
  font-size: 13px;
  cursor: pointer;
}

.tb-divider {
  width: 1px;
  height: 22px;
  margin: 0 4px;
  background: #ddd;
}

/* ================= EDITOR BODY ================= */

.editor-shell {
  border: 1px solid #e2e2e2;
  border-top: none;
  border-radius: 0 0 10px 10px;
  padding: 24px;
  background: white;
}

.note-editor {
  min-height: 480px;
  width: 100%;
}

.note-editor .ProseMirror {
  min-height: 480px;
  outline: none;
  border: none;
  padding: 0;
  font-size: 16px;
  line-height: 1.75;
  color: #292929;
  caret-color: #111;
}

.note-editor .ProseMirror p.is-editor-empty:first-child::before {
  content: attr(data-placeholder);
  float: left;
  height: 0;
  pointer-events: none;
  color: #a5a5a5;
}

.note-editor .ProseMirror p {
  margin: 0 0 12px;
}

.note-editor .ProseMirror h1 {
  font-size: 30px;
  line-height: 1.25;
  margin: 24px 0 12px;
}

.note-editor .ProseMirror h2 {
  font-size: 24px;
  line-height: 1.3;
  margin: 20px 0 10px;
}

.note-editor .ProseMirror h3 {
  font-size: 20px;
  line-height: 1.35;
  margin: 16px 0 8px;
}

.note-editor .ProseMirror ul,
.note-editor .ProseMirror ol {
  padding-left: 28px;
  margin: 8px 0 16px;
}

.note-editor .ProseMirror li p {
  margin: 0;
}

.note-editor .ProseMirror blockquote {
  margin: 20px 0;
  padding: 4px 0 4px 20px;
  border-left: 3px solid #d1d1d1;
  color: #666;
}

.note-editor .ProseMirror code {
  padding: 2px 5px;
  border-radius: 5px;
  background: #f1f1f1;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.9em;
}

.note-editor .ProseMirror a {
  color: #2563eb;
  text-decoration: underline;
  cursor: pointer;
}

/* ================= FOOTER ================= */

.note-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30px;
  padding-top: 20px;
  border-top: 1px solid #eeeeee;
}

.expiry {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #777;
  font-size: 13px;
}

.expiry select {
  border: none;
  background: transparent;
  color: #555;
  cursor: pointer;
  outline: none;
}

.note-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cancel-btn,
.save-btn {
  padding: 9px 16px;
  border-radius: 8px;
  font-size: 14px;
  text-decoration: none;
  cursor: pointer;
  border: none;
}

.cancel-btn {
  color: #666;
}

.cancel-btn:hover {
  background: #f5f5f5;
}

.save-btn {
  background: #202124;
  color: white;
}

.save-btn:hover {
  background: #000;
}

@media (max-width: 700px) {
  .note-page {
    padding: 24px 16px 80px;
  }

  .note-header input {
    font-size: 28px;
  }

  .editor-toolbar {
    gap: 2px;
  }

  .note-footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
  }
}

</style>

<script type="module" src="/js/note-editor.js"></script>

<%- include('../partials/footer') %>