<!-- views/notes/create.ejs -->
<%- include('../partials/header') %>

<div class="note-page">

  <div class="note-header">
    <input
      id="title"
      type="text"
      name="title"
      form="note-form"
      value="<%= old?.title || '' %>"
      placeholder="Untitled"
      autocomplete="off"
    >
  </div>

  <% if (errors) { %>
    <div class="note-errors">
      <ul>
        <% Object.values(errors).flat().forEach(msg => { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form id="note-form" action="/notes" method="POST">

    <div id="editor-container">
      <div id="editor"></div>
    </div>

    <textarea id="initial-content" hidden><%= old?.content || '<p></p>' %></textarea>
    <input type="hidden" name="content" id="content-input">

    <div class="note-footer">
      <div class="expiry">
        <label for="expiryChoice">Auto-delete</label>
        <select id="expiryChoice" name="expiryChoice">
          <option value="never" selected>Never</option>
          <option value="24h">After 24 hours</option>
          <option value="3d">After 3 days</option>
          <option value="7d">After 7 days</option>
        </select>
      </div>

      <div class="note-actions">
        <a href="/notes" class="cancel-btn">Cancel</a>
        <button type="submit" class="save-btn">Save note</button>
      </div>
    </div>

  </form>

</div>

<style>

.note-page {
  max-width: 850px;
  margin: 0 auto;
  padding: 40px 32px 100px;
  color: #202124;
}

.note-header input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  font-size: 38px;
  font-weight: 700;
  letter-spacing: -1px;
  color: #202124;
  margin-bottom: 18px;
}

.note-header input::placeholder {
  color: #b7b7b7;
}

.note-errors {
  margin-bottom: 20px;
  padding: 12px 16px;
  border-radius: 10px;
  background: #fff1f1;
  color: #b42318;
}

.note-errors ul {
  margin: 0;
  padding-left: 20px;
}

#editor-container {
  border: 1px solid #e2e2e2;
  border-radius: 10px;
  overflow: hidden;
}

#editor {
  min-height: 480px;
  background: white;
  font-size: 16px;
}

.ql-toolbar.ql-snow {
  border: none;
  border-bottom: 1px solid #e2e2e2;
  background: #fafafa;
}

.ql-container.ql-snow {
  border: none;
}

.note-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30px;
  padding-top: 20px;
  border-top: 1px solid #eeeeee;
}

.expiry {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #777;
  font-size: 13px;
}

.expiry select {
  border: none;
  background: transparent;
  color: #555;
  cursor: pointer;
}

.note-actions {
  display: flex;
  gap: 8px;
}

.cancel-btn,
.save-btn {
  padding: 9px 16px;
  border-radius: 8px;
  font-size: 14px;
  text-decoration: none;
  border: none;
  cursor: pointer;
}

.cancel-btn {
  color: #666;
}

.cancel-btn:hover {
  background: #f5f5f5;
}

.save-btn {
  background: #202124;
  color: white;
}

.save-btn:hover {
  background: #000;
}

@media (max-width: 700px) {
  .note-page {
    padding: 24px 16px 80px;
  }
  .note-header input {
    font-size: 28px;
  }
}

</style>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script src="/js/note-editor.js"></script>

<%- include('../partials/footer') %>